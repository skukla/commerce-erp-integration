# The log level configured for all the actions (can be overridden per-action).
LOG_LEVEL=info

# Where the ERP's actions live: the demo-erp app's web-action base, e.g.
# https://<namespace>.adobeio-static.net/api/v1/web/demo-erp
# Demo Builder writes it from the ERP component's deployed URLs.
ERP_BASE_URL=

# The IMS server-to-server credential (AIO_COMMERCE_AUTH_IMS_*) is injected by the deploy;
# it authenticates every call to Commerce AND to the ERP.
